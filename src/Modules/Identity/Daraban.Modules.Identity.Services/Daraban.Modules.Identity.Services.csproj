<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- AgentService.HashSecret is internal so no caller outside this assembly can accidentally
         treat it as a general-purpose password hasher (it is a plain SHA-256, correct only for
         high-entropy machine secrets). The test project needs it to build valid credential
         fixtures, so it is granted access explicitly rather than the method being made public. -->
    <InternalsVisibleTo Include="Daraban.Modules.Identity.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Daraban.Modules.Identity.Data\Daraban.Modules.Identity.Data.csproj" />
    <ProjectReference Include="..\..\..\Shared\Daraban.Platform.Common\Daraban.Platform.Common.csproj" />
    <ProjectReference Include="..\..\..\Shared\Daraban.Platform.Abstractions\Daraban.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\Daraban.Platform.Contracts\Daraban.Platform.Contracts.csproj" />
  </ItemGroup>
</Project>
