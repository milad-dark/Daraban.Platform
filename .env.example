# =============================================================================
# Daraban Platform — Environment Variables
# =============================================================================
#
# PostgreSQL
POSTGRES_USER=daraban
POSTGRES_PASSWORD=daraban_dev_password_123
POSTGRES_DB=daraban_platform
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=daraban
RABBITMQ_DEFAULT_PASS=daraban_dev_password_123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT Authentication
JWT__SigningKeyPemPath=/app/certs/jwt-signing-key.pem
JWT__Issuer=https://daraban.local
JWT__Audience=daraban-api
JWT__AccessTokenExpirationMinutes=15
JWT__RefreshTokenExpirationDays=7

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Connection Strings
CONNECTIONSTRINGS__Postgres=Host=postgres;Port=5432;Database=daraban_platform;Username=daraban;Password=daraban_dev_password_123
CONNECTIONSTRINGS__Redis=redis:6379

# RabbitMQ Connection
RABBITMQ__Host=rabbitmq
RABBITMQ__Port=5672
RABBITMQ__Username=daraban
RABBITMQ__Password=daraban_dev_password_123

# Host Ports
HOST_API_PORT=5000
HOST_AGENTAPI_PORT=5001
NGINX_PORT=80

# Logging
SERILOG__MinimumLEVEL__DEFAULT=Debug

# Image provenance (docker-compose `image:` keys / CD deploy)
# Set to your Docker Hub owner on the server; DARABAN_TAG is flipped by cd.yml.
DOCKERHUB_USERNAME=local
DARABAN_TAG=latest
