# =============================================================================
# Daraban Platform — Environment Variables
# =============================================================================
#
# PostgreSQL
POSTGRES_USER=daraban
POSTGRES_PASSWORD=daraban_dev_password_123
POSTGRES_DB=daraban_platform
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=daraban
RABBITMQ_DEFAULT_PASS=daraban_dev_password_123
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# JWT Authentication
JWT__SigningKeyPemPath=/app/certs/jwt-signing-key.pem
JWT__Issuer=https://daraban.local
JWT__Audience=daraban-api
JWT__AccessTokenExpirationMinutes=15
JWT__RefreshTokenExpirationDays=7

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Connection Strings
CONNECTIONSTRINGS__Postgres=Host=postgres;Port=5432;Database=daraban_platform;Username=daraban;Password=daraban_dev_password_123
CONNECTIONSTRINGS__Redis=redis:6379

# RabbitMQ Connection
RABBITMQ__Host=rabbitmq
RABBITMQ__Port=5672
RABBITMQ__Username=daraban
RABBITMQ__Password=daraban_dev_password_123

# Host Ports
HOST_API_PORT=5000
HOST_AGENTAPI_PORT=5001
NGINX_PORT=80

# Logging
SERILOG__MinimumLEVEL__DEFAULT=Debug

# Image provenance (docker-compose `image:` keys / CD deploy)
# Set to your Docker Hub owner on the server; DARABAN_TAG is flipped by cd.yml.
DOCKERHUB_USERNAME=local
DARABAN_TAG=latest

# --- Production edge (Task 8.4; only read by docker-compose.prod.yml) ---
# Public hostname served by nginx (SNI + certbot -d). No default on purpose:
# deploying without a real domain must fail loudly, not silently serve _.
DOMAIN=
# Contact for Let's Encrypt expiry notices (init-letsencrypt.sh only).
EMAIL=
# Explicit HTTP/HTTPS host ports (default 80/443).
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# --- Monitoring (Task 8.4; Grafana first-run admin only) ---
# Change immediately in the Grafana UI; afterwards Grafana keeps its own user
# store and ignores these. The :? guard in docker-compose.prod.yml refuses to
# start Grafana without a password set -- no default admin/admin in production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Backups (Task 8.4; deploy/backup/backup.sh, NOT docker compose) ---
# Root-only file holding the openssl passphrase (chmod 600, never in git).
# BACKUP_PASSPHRASE_FILE=/root/.daraban-backup-pass
# Where encrypted snapshots live on the host.
# BACKUP_ROOT=/var/backups/daraban
# Off-server copy target (empty = local only, with a warning each run).
# BACKUP_REMOTE=backup@store:/srv/daraban
# Retention overrides (defaults: 7 daily, 4 weekly, 12 monthly).
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=12
