{
  "title": "Daraban Platform — Service Health",
  "uid": "daraban-health",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s by service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "daraban-prom" },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_requests_received_total[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } }
    },
    {
      "id": 2,
      "title": "Error rate (5xx share by service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "daraban-prom" },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_requests_received_total{code=~\"5..\"}[5m])) / sum by (job) (rate(http_requests_received_total[5m]))",
          "legendFormat": "{{job}} errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "RabbitMQ queue depth (ready messages)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "daraban-prom" },
      "targets": [
        {
          "expr": "sum by (queue) (rabbitmq_queue_messages_ready)",
          "legendFormat": "{{queue}} ready",
          "refId": "A"
        },
        {
          "expr": "sum by (queue) (rabbitmq_queue_messages_unacknowledged)",
          "legendFormat": "{{queue}} unacked",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 } }
    },
    {
      "id": 4,
      "title": "Process memory (working set by service)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "daraban-prom" },
      "targets": [
        {
          "expr": "sum by (job) (process_working_set_bytes)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 } }
    },
    {
      "id": 5,
      "title": "Host memory pressure",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "daraban-prom" },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "used share",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "id": 6,
      "title": "Root disk free share",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "daraban-prom" },
      "targets": [
        {
          "expr": "node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "red" }, { "value": 0.15, "color": "yellow" }, { "value": 0.3, "color": "green" }] } }
      }
    }
  ]
}
